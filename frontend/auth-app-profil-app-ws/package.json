{
    "name": "@auth-app-profil-app-ws/source",
    "version": "9.3.0",
    "license": "MIT",
    "scripts": {
        "auth": "npx nx serve authprovider --proxy-config=proxy.conf.authprovider.json --port 4300",
        "profil": "npx nx serve benutzerprofil --proxy-config=proxy.conf.benutzerprofil.json --port 4400",
        "build:authprovider:local": "npx nx build authprovider -c local --output-hashing=all --base-href /authprovider/ --skip-nx-cache",
        "build:authprovider:docker": "npx nx build authprovider -c docker --output-hashing=all --base-href /authprovider/ --skip-nx-cache",
        "build:authprovider:qs": "npx nx build authprovider -c heikeqs --output-hashing=all --base-href /authprovider/ --skip-nx-cache",
        "build:authprovider:prod": "NX_DAEMON=false npx nx run authprovider:build:production --verbose --output-hashing=all --base-href /authprovider/ --skip-nx-cache",
        "build:benutzerprofil:local": "npx nx build benutzerprofil -c local --output-hashing=all --base-href /benutzerprofil/ --skip-nx-cache",
        "build:benutzerprofil:docker": "npx nx build benutzerprofil -c docker --output-hashing=all --base-href /benutzerprofil/ --skip-nx-cache",
        "build:benutzerprofil:qs": "npx nx build benutzerprofil -c heikeqs --output-hashing=all --base-href /benutzerprofil/ --skip-nx-cache",
        "build:benutzerprofil:prod": "NX_DAEMON=false npx nx run benutzerprofil:build:production --output-hashing=all --base-href /benutzerprofil/ --skip-nx-cache",
        "test": "npx nx test",
        "test:all": "npx nx run-many --target=test --all",
        "lint:all": "npx nx run-many --target=lint --all",
        "full-check": "npx nx run-s lint:all test:all build",
        "format": "prettier --write \"**/*.{ts,html,scss}\" --ignore-path .gitignore",
        "format:check": "prettier --check \"**/*.{ts,html,scss}\" --ignore-path .gitignore",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint --fix \"src/**/*.ts\"",
        "graph": "npx nx graph"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "21.2.9",
        "@angular/cdk": "21.2.9",
        "@angular/common": "21.2.9",
        "@angular/core": "21.2.9",
        "@angular/forms": "21.2.9",
        "@angular/material": "21.2.9",
        "@angular/platform-browser": "21.2.9",
        "@angular/platform-browser-dynamic": "21.2.9",
        "@angular/router": "21.2.9",
        "@ngrx/effects": "21.1.1",
        "@ngrx/operators": "21.1.1",
        "@ngrx/router-store": "21.1.1",
        "@ngrx/store": "21.1.1",
        "@ngrx/store-devtools": "21.1.1",
        "material-icons": "^1.13.14",
        "ngrx-store-localstorage": "^19.0.0",
        "rxjs": "7.8.1",
        "tslib": "^2.6.2",
        "zone.js": "0.16.3"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "21.2.9",
        "@angular-devkit/core": "21.2.9",
        "@angular-devkit/schematics": "21.2.9",
        "@angular-eslint/eslint-plugin": "21.4.0",
        "@angular-eslint/eslint-plugin-template": "21.4.0",
        "@angular-eslint/template-parser": "21.4.0",
        "@angular/cli": "21.2.9",
        "@angular/compiler": "21.2.9",
        "@angular/compiler-cli": "21.2.9",
        "@angular/language-service": "21.2.9",
        "@ngrx/eslint-plugin": "21.1.1",
        "@nx/angular": "22.7.5",
        "@nx/cypress": "22.7.5",
        "@nx/devkit": "22.7.5",
        "@nx/eslint": "22.7.5",
        "@nx/eslint-plugin": "22.7.5",
        "@nx/jest": "22.7.5",
        "@nx/js": "22.7.5",
        "@nx/playwright": "22.7.5",
        "@nx/workspace": "22.7.5",
        "@playwright/test": "^1.36.0",
        "@schematics/angular": "21.2.9",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.20",
        "@swc/helpers": "0.5.23",
        "@types/jest": "30.0.0",
        "@types/node": "18.19.9",
        "@types/ungap__structured-clone": "^0.3.0",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "@typescript-eslint/utils": "8.72.0",
        "angular-eslint": "21.4.0",
        "autoprefixer": "^10.4.0",
        "cypress": "15.9.0",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "10.1.2",
        "eslint-plugin-cypress": "2.15.1",
        "eslint-plugin-playwright": "^2.2.0",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jest-environment-node": "^29.4.1",
        "jest-preset-angular": "16.0.0",
        "jest-util": "30.5.1",
        "jsonc-eslint-parser": "^2.1.0",
        "ng-packagr": "21.2.7",
        "npm-run-all": "^4.1.5",
        "nx": "22.7.5",
        "postcss": "^8.4.5",
        "postcss-import": "~14.1.0",
        "postcss-preset-env": "~7.5.0",
        "postcss-url": "~10.1.3",
        "prettier": "^3.1.0",
        "ts-jest": "29.4.0",
        "ts-node": "10.9.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "eslint --max-warnings=0 --fix",
            "prettier --write"
        ],
        "*.html": [
            "eslint --max-warnings=0 --fix",
            "prettier --write"
        ],
        "*.{css,scss,md,json,yml,yaml}": [
            "prettier --write"
        ]
    }
}
