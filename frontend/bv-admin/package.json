{
    "name": "@bv-admin/source",
    "version": "1.2.1",
    "license": "MIT",
    "scripts": {
        "ng": "nx",
        "start": "NX_DAEMON=false nx serve --proxy-config=proxy.conf.json",
        "build:local": "NX_DAEMON=false npx nx build bv-admin -c local --verbose --output-hashing=all --base-href /bv-admin/ --skip-nx-cache",
        "build:heikeqs": "NX_DAEMON=false npx nx build bv-admin -c heikeqs --verbose --output-hashing=all --base-href /bv-admin/ --skip-nx-cache",
        "build:prod": "NX_DAEMON=false npx nx run bv-admin:build:production --verbose --output-hashing=all --base-href /bv-admin/ --skip-nx-cache",
        "test": "NX_DAEMON=false npx nx test",
        "test:all": "NX_DAEMON=false npx nx run-many --target=test --all",
        "lint:all": "NX_DAEMON=false npx nx run-many --target=lint --all",
        "full-check": "NX_DAEMON=false npx nx run-s lint:all test:all build",
        "sheriff": "NX_DAEMON=false npx sheriff verify src/main.ts"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "21.2.9",
        "@angular/cdk": "21.2.9",
        "@angular/common": "21.2.9",
        "@angular/compiler": "21.2.9",
        "@angular/core": "21.2.9",
        "@angular/forms": "21.2.9",
        "@angular/material": "21.2.9",
        "@angular/platform-browser": "21.2.9",
        "@angular/platform-browser-dynamic": "21.2.9",
        "@angular/router": "21.2.9",
        "@ngrx/effects": "21.1.1",
        "@ngrx/operators": "21.1.1",
        "@ngrx/router-store": "21.1.1",
        "@ngrx/store": "21.1.1",
        "@ngrx/store-devtools": "21.1.1",
        "@nx/angular": "22.7.5",
        "material-icons": "~1.13.12",
        "ngrx-store-localstorage": "20.1.0",
        "rxjs": "~7.8.0",
        "zone.js": "0.16.3"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "21.2.9",
        "@angular-devkit/core": "21.2.9",
        "@angular-devkit/schematics": "21.2.9",
        "angular-eslint": "21.4.0",
        "@angular-eslint/eslint-plugin": "21.4.0",
        "@angular-eslint/eslint-plugin-template": "21.4.0",
        "@angular-eslint/template-parser": "21.4.0",
        "@angular/cli": "21.2.9",
        "@angular/compiler-cli": "21.2.9",
        "@angular/language-service": "21.2.9",
        "@eslint/eslintrc": "^2.1.1",
        "@eslint/js": "~8.57.0",
        "@nx/devkit": "22.7.5",
        "@nx/eslint": "22.7.5",
        "@nx/eslint-plugin": "22.7.5",
        "@nx/jest": "22.7.5",
        "@nx/js": "22.7.5",
        "@nx/playwright": "22.7.5",
        "@nx/workspace": "22.7.5",
        "@playwright/test": "~1.45.1",
        "@schematics/angular": "21.2.9",
        "@softarc/eslint-plugin-sheriff": "~0.15.1",
        "@softarc/sheriff-core": "~0.15.1",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.20",
        "@swc/helpers": "0.5.23",
        "@types/jest": "30.0.0",
        "@types/node": "22.20.5",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "@typescript-eslint/utils": "8.72.0",
        "eslint": "9.31.0",
        "eslint-config-prettier": "10.1.2",
        "eslint-plugin-playwright": "2.2.0",
        "fs-extra": "~11.2.0",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jest-preset-angular": "16.0.0",
        "jsdom": "26.1.0",
        "nx": "22.7.5",
        "prettier": "~2.8.8",
        "ts-jest": "^29.4.0",
        "ts-node": "10.9.1",
        "tslib": "~2.6.3",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.40.0",
        "webpack-bundle-analyzer": "~4.10.2"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "eslint --max-warnings=0 --fix",
            "prettier --write"
        ],
        "*.html": [
            "eslint --max-warnings=0 --fix",
            "prettier --write"
        ],
        "*.{css,scss,md,json,yml,yaml}": [
            "prettier --write"
        ]
    },
    "nx": {
        "includedScripts": []
    }
}
